# =============================================================
#  Tunisia Job Market Intelligence Platform
#  Fichier modèle — SAFE à committer dans Git
#  Copie en .env et remplace les valeurs par les tiennes
# =============================================================

# ── PostgreSQL ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tunisia_jobs
DB_USER=postgres
DB_PASSWORD=

DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/tunisia_jobs

# ── OpenRouter (LLaMA 3 via API) ─────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# ── Backend CORS ─────────────────────────────────────────────
# Comma-separated frontend origins, e.g. https://your-app.vercel.app
BACKEND_CORS_ORIGINS=http://localhost:3000
BACKEND_CORS_ORIGIN_REGEX=


# ── LinkedIn (optionnel) ──────────────────────────────────────
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=

# ── Apify (optional job-board actor) ─────────────────────────
# Leave blank to skip Apify without affecting the other scrapers.
APIFY_TOKEN=
APIFY_ACTOR_ID=
APIFY_INPUT_JSON={}

# ── Scrapers ──────────────────────────────────────────────────
SCRAPE_DELAY_MIN=1.5
SCRAPE_DELAY_MAX=4.0
MAX_PAGES_EMPLOI_TN=20
MAX_PAGES_TANITJOBS=15
MAX_PAGES_REKRUTE=10

# ── Scheduler ─────────────────────────────────────────────────
SCRAPE_TIME=07:00

# ── Logs ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=scrape.log

# ── Exports ───────────────────────────────────────────────────
EXPORT_DIR=exports
